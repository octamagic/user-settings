# Copy to environment.auto.tfvars (gitignored). In CI these arrive through the
# TF_SECRET_VARS secret of the terraform workflow.
vpc_id                  = "vpc-0123456789abcdef0"
private_subnet_ids      = ["subnet-aaaaaaaa", "subnet-bbbbbbbb"]
alb_subnet_ids          = ["subnet-cccccccc", "subnet-dddddddd"]
user_directory_base_url = "http://user-directory.staging.internal:8080"
